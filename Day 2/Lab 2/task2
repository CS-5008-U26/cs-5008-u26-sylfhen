/*Write a program to print all the numbers from 0 to 1500 that are multiples of 63.  Print them in a column, right-justified*/
#include <stdio.h>
int main(){
    int i; // initialize i
    for (i = 0; i <= 1500; i++) { // loop from 0 to 1500
        if (i % 63 == 0) { // check if i is a multiple of 63
            printf("%4d\n", i); // print i right-justified in a column
        }
    }
    return 0;   
} 