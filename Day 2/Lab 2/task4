#include <stdio.h>
#include <time.h>
#include <math.h>

int main() {
    clock_t start = clock(); // start the timer
    
    printf("2\n"); // print 2, the first prime number
    for (int i = 3; i <= 1000000; i += 2) { // check divisibility by all integers less than n
        int prime = 1; // assume i is prime until we find a divisor
        int sqrt_i = (int)sqrt((double)i); // calculate the square root of i to optimize the inner loop
        for (int j = 2; j <= sqrt_i; j++) { // check divisibility by integers from 2 to sqrt(i)
            if (i % j == 0) {
                prime = 0; // set prime to 0 to indicate i is not prime
                break; // exit the inner loop since we found a divisor
            }
        }
        if (prime) {
            printf("%d\n", i); // print i if it is prime
        }
    }
    
    clock_t end = clock(); // end the timer
 
    double time_taken = ((double)(end - start)) / CLOCKS_PER_SEC; // calculate the time taken
    printf("Time taken: %f seconds\n", time_taken); // print the time
    return 0;
}