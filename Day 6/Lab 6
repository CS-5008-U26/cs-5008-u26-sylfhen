/* 
 * cities.c
 *
 * Getting data about US cities from a CSV file.
 * Task 1B: stringToCity and readCityList functions.
 */

/* Standard Libraries */
#include <stdio.h>
#include <string.h>
#include <stdlib.h>

/* Struct to store city record fields */
typedef struct city_struct {
    char *name;
    char *nameASCII;
    double latitude;
    double longitude;
    int population;
} city;

/* Strip a trailing newline from str, if present */
void killNewline(char *str) {
    size_t len = strlen(str);
    if (len > 0 && str[len - 1] == '\n') {
        str[len - 1] = '\0';
    }
}

/*
 * getNextField
 * Extract the next comma-separated field from 'start' into 'out'.
 * Returns a pointer to the character just after the separator (or end of string).
 */
char *getNextField(char *start, char separator, char *out) {
    /* No more fields */
    if (*start == '\0') {
        out[0] = '\0';
        return start;
    }

    /* Find the position of the next separator */
    char *sepPos = strchr(start, separator);

    if (sepPos == NULL) {
        /* No separator found: copy the rest of the string */
        strcpy(out, start);

        /* Strip double-quotes if present */
        int outLen = strlen(out);
        if (outLen >= 2 && out[0] == '"' && out[outLen - 1] == '"') {
            out[outLen - 1] = '\0';
            memmove(out, out + 1, outLen - 1);
        }

        return start + strlen(start);
    } else {
        /* Copy characters up to the separator */
        size_t fieldLength = sepPos - start;
        strncpy(out, start, fieldLength);
        out[fieldLength] = '\0';

        /* Strip double-quotes if present */
        int outLen = strlen(out);
        if (outLen >= 2 && out[0] == '"' && out[outLen - 1] == '"') {
            out[outLen - 1] = '\0';
            memmove(out, out + 1, outLen - 1);
        }

        return sepPos + 1;
    }
}

/*
 * stringToCity
 * Parse one CSV line into a heap-allocated city struct.
 * CSV column layout (1-indexed):
 *   1: city name
 *   2: city ASCII name
 *   3: state name
 *   4: state id
 *   5: county name
 *   6: county fips
 *   7: latitude
 *   8: longitude
 *   9: population
 *   (remaining columns ignored)
 *
 * All string fields are strdup'd onto the heap.
 * The struct itself is malloc'd onto the heap.
 * Returns a pointer to the new city, or NULL on failure.
 */
city *stringToCity(char *textLine) {
    /* Allocate the struct on the heap */
    city *c = (city *)malloc(sizeof(city));
    if (c == NULL) {
        fprintf(stderr, "malloc failed in stringToCity\n");
        return NULL;
    }

    char field[1000];
    char *ptr = textLine;
    int fieldIndex = 1;

    /* Walk through every comma-separated field */
    while (*ptr != '\0') {
        ptr = getNextField(ptr, ',', field);

        switch (fieldIndex) {
            case 1:
                c->name = strdup(field);
                break;
            case 2:
                c->nameASCII = strdup(field);
                break;
            case 7:
                c->latitude = atof(field);
                break;
            case 8:
                c->longitude = atof(field);
                break;
            case 9:
                c->population = atoi(field);
                break;
            default:
                break;
        }

        fieldIndex++;
    }

    return c;
}

/*
 * readCityList
 * Open 'filename', discard the header line, then read the next 20 lines.
 * For each line, call stringToCity to build a heap-allocated city struct.
 * Returns a heap-allocated array of 20 city* pointers.
 * The caller is responsible for freeing both the structs and the array.
 */
city **readCityList(char *filename) {
    FILE *file = fopen(filename, "r");
    if (file == NULL) {
        fprintf(stderr, "Error opening file: %s\n", filename);
        return NULL;
    }

    /* Discard the header line */
    char buffer[1000];
    fgets(buffer, 1000, file);

    /* Allocate the array of 20 city pointers on the heap */
    city **cityArray = (city **)malloc(20 * sizeof(city *));
    if (cityArray == NULL) {
        fprintf(stderr, "malloc failed for cityArray\n");
        fclose(file);
        return NULL;
    }

    int count = 0;
    while (count < 20 && fgets(buffer, 1000, file) != NULL) {
        killNewline(buffer);
        cityArray[count] = stringToCity(buffer);
        count++;
    }

    fclose(file);
    return cityArray;
}

int main(void) {
    city **cityArray;

    cityArray = readCityList("../../Resources/uscities.csv");
    if (cityArray == NULL) {
        fprintf(stderr, "Failed to read city list.\n");
        return 1;
    }

    /* Interactive lookup loop*/
    char inputBuffer[1000];
    while (1) {
        printf("Enter a city name (or 'exit' to quit): ");

        if (fgets(inputBuffer, 1000, stdin) == NULL) {
            break;
        }
        
        /*Check if inputBuffer is a new line (Just Enter) Exit*/
        if ((inputBuffer[0] == '\n')) {
            break;
        }
        /*If User chose outside the boundary of 1 and 20*/
        if ((strcmp(inputBuffer, "1") < 0) || (strcmp(inputBuffer, "20") > 0)) {
            printf("Please enter a number between 1 and 20.\n");
            continue;
        }
        
        killNewline(inputBuffer);

        if (strcmp(inputBuffer, "exit") == 0) {
            break;
        }

        int found = 0;
        for (int i = 0; i < 20; i++) {
            if (cityArray[i] != NULL && strcmp(cityArray[i]->name, inputBuffer) == 0) {
                printf("City: %s\n", cityArray[i]->name);
                printf("ASCII Name: %s\n", cityArray[i]->nameASCII);
                printf("Latitude: %f\n", cityArray[i]->latitude);
                printf("Longitude: %f\n", cityArray[i]->longitude);
                printf("Population: %d\n", cityArray[i]->population);
                found = 1;
                break;
            }
        }

        if (!found) {
            printf("City '%s' not found in the list.\n", inputBuffer);
        }
    }




    /* Free all heap memory */
    for (int i = 0; i < 20; i++) {
        if (cityArray[i] != NULL) {
            free(cityArray[i]->name);
            free(cityArray[i]->nameASCII);
            free(cityArray[i]);
        }
    }
    free(cityArray);

    return 0;
}